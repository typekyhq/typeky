# ============================================================================
# Local private material -- not version controlled
# ============================================================================
# This repository is published under AGPLv3. The paths below hold maintainer-only
# material and must never be committed.
/internal/
/AGENTS.md
/CLAUDE.md
*.local.md
*.private.md
/notes/

# ============================================================================
# Dependencies
# ============================================================================
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ============================================================================
# Build output
# ============================================================================
dist/
build/
out/
*.tsbuildinfo

# Site and admin build output. The three directories under public/ are all
# generated by the build (see CONTRIBUTING.md section 6), as is the cache policy
# that ships with them.
public/admin/
public/theme/
public/static/
public/_headers

# Wrangler artifacts
.wrangler/
worker-configuration.d.ts
.dev.vars.bak

# ============================================================================
# Environment variables and secrets -- never commit
# ============================================================================
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# White-label ED25519 private key and signing output (CONTRIBUTING.md section 4)
/keys/
*.pem
*.key
id_ed25519*
license-*.json

# ============================================================================
# Tests and coverage
# ============================================================================
coverage/
.nyc_output/
playwright-report/
test-results/

# ============================================================================
# Logs
# ============================================================================
*.log

# ============================================================================
# Editors and OS
# ============================================================================
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
