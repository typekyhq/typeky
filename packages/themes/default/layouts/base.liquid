<!doctype html>
<html lang="{{ site.language | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% render 'snippets/seo-meta', seo: seo, page: page %}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  </head>
  <body>
    {% render 'snippets/header', site: site %}
    <main id="main">
      {% block %}{% endblock %}
    </main>
    {% render 'snippets/footer', site: site %}
    {% render 'snippets/cookie-consent', site: site %}
  </body>
</html>
