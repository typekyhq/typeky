<!doctype html>
<html lang="{{ site.language | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% comment %}
      One scheme, declared: the theme is light, and this is what tells the browser
      to draw form controls, scrollbars and the canvas to match. It used to declare
      both and follow the reader's system, which turned every page black for anyone
      in dark mode -- a palette nobody had designed.
    {% endcomment %}
    <meta name="color-scheme" content="light">
    {% render 'snippets/seo-meta', seo: seo, page: page, site: site, content: content %}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  </head>
  <body>
    {% comment %}
      First in the document, because its whole point is to be the first thing a
      keyboard user can reach. Hidden until it has focus.
    {% endcomment %}
    <a class="visually-hidden" href="#main">Skip to content</a>
    {% render 'snippets/header', site: site %}
    <main id="main">
      {% block %}{% endblock %}
    </main>
    {% render 'snippets/footer', site: site %}
    {% render 'snippets/cookie-consent', site: site %}
  </body>
</html>
