{% layout 'layouts/base' %}
<article class="product">
  <header class="product-header">
    <h1>{{ content.title }}</h1>
    {% comment %}
      The summary the operator wrote, shown as the standfirst -- the same field the
      list cards use, so the description does not change between the list and the
      page it links to.
    {% endcomment %}
    {% if content.excerpt %}<p class="lead">{{ content.excerpt }}</p>{% endif %}
    {% comment %}
      The terms this product is filed under, beside the price. A product can carry
      more than one, so this iterates rather than printing a single value.
    {% endcomment %}
    {% if content.terms.size > 0 %}
      <p class="meta">
        {% for term in content.terms %}<span class="term" title="{{ term.vocabulary }}">{{ term.name }}</span>{% endfor %}
      </p>
    {% endif %}
    {% if content.price_label %}<p class="price">{{ content.price_label }}</p>{% endif %}
  </header>

  {% if content.cover_url %}
    <img class="cover" src="{{ content.cover_url }}" alt="{{ content.title }}">
  {% endif %}

  {% comment %}
    The gallery holds media ids the platform has already resolved to URLs. A
    theme never sees an id it would have to look up, and never a storage key.
  {% endcomment %}
  {% if content.gallery.size > 0 %}
    <ul class="gallery">
      {% for image in content.gallery %}
        <li><img src="{{ image }}" alt="{{ content.title }}"></li>
      {% endfor %}
    </ul>
  {% endif %}

  {{ content.blocks | render_blocks }}

  {% if content.specs.size > 0 %}
    <dl class="specs">
      {% for spec in content.specs %}
        <dt>{{ spec.label }}</dt><dd>{{ spec.value }}</dd>
      {% endfor %}
    </dl>
  {% endif %}

  {% if content.cta_url %}
    {% comment %}
      The button leaves the site -- there is no checkout here, on purpose. `rel`
      keeps the destination from reaching back through the window it opened.

      The hint is for a screen reader, which cannot see a new tab appear. It is
      hidden by the stylesheet, which is why it arrived with one and not before:
      written earlier it was visible to everybody, as a sentence no sighted
      reader wants.
    {% endcomment %}
    <p class="cta">
      <a href="{{ content.cta_url }}" rel="noopener noreferrer" target="_blank">{{ content.cta_label | default: 'Learn more' }}<span class="visually-hidden"> (opens in a new tab)</span></a>
    </p>
  {% endif %}
</article>
