{% layout 'layouts/base' %}
{% comment %}
  A term's archive: everything published under one term, newest first.

  A term can carry posts and products at once, so each row picks the card that
  matches what the summary actually has -- a product summary has a price and a
  post's does not. The description is the term's own words, or the vocabulary's
  when the term has none.
{% endcomment %}
<header class="list-header">
  <h1>{{ page.title }}</h1>
</header>

{% if page.description %}<p class="lead">{{ page.description }}</p>{% endif %}

<ul class="post-list">
  {% for item in content %}
    <li>
      {% if item.price_label %}
        {% render 'snippets/product-card', product: item %}
      {% else %}
        {% render 'snippets/post-card', post: item, site: site %}
      {% endif %}
    </li>
  {% else %}
    <li class="empty">Nothing is filed here yet.</li>
  {% endfor %}
</ul>

{% render 'snippets/pagination', page: page %}
