{% layout 'layouts/base' %}
<h1>{{ page.title | default: 'Products' }}</h1>
<ul class="product-list">
  {% for product in content %}
    <li>{% render 'snippets/product-card', product: product %}</li>
  {% else %}
    <li class="empty">No products yet.</li>
  {% endfor %}
</ul>
{% render 'snippets/pagination', page: page %}
