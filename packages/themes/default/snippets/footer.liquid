<footer class="site-footer">
  {% if site.settings.footer %}<p>{{ site.settings.footer }}</p>{% endif %}
  {% if site.settings.social_links.size > 0 %}
    <ul class="social">
      {% for link in site.settings.social_links %}
        <li><a href="{{ link.href }}">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
  {% comment %}
    Present unless the site bought a white-label licence, in which case the platform
    leaves it out of the context altogether. The marker attribute is what tells the
    platform this theme rendered it; see `injectAttribution` in @typeky/core.
  {% endcomment %}
  {% if site.attribution %}
    <p class="attribution">
      <a href="{{ site.attribution.url }}" rel="noopener" data-typeky-attribution>{{ site.attribution.text }}</a>
    </p>
  {% endif %}
</footer>
