<header class="site-header">
  <a class="brand" href="{{ '/' | url }}">
    {% if site.logo_url %}<img src="{{ site.logo_url }}" alt="{{ site.name }}">{% else %}{{ site.name }}{% endif %}
  </a>
  <nav aria-label="Main">
    <ul>
      {% for item in site.nav %}
        <li><a href="{{ item.href | url }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>
