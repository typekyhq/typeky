{% comment %}
  One row of the post list. `post` is what the caller passes: a summary, not the
  whole document -- a list renders titles and summaries, and the bodies of ten
  posts would be a page's context with ten posts' worth of JSON nothing reads.
{% endcomment %}
<article class="card">
  {% if post.cover_url %}
    <a class="card-cover" href="{{ post.url | url }}">
      <img src="{{ post.cover_url }}" alt="{{ post.title }}">
    </a>
  {% endif %}

  {% comment %}
    The text is wrapped so the stylesheet can give the card a border and a clipped
    cover without also padding the image: the body carries the padding, the cover
    runs to the edge.
  {% endcomment %}
  <div class="card-body">
    <h2><a href="{{ post.url | url }}">{{ post.title }}</a></h2>

    <p class="meta">
      {% if post.published_at %}
        <time datetime="{{ post.published_at }}">{{ post.published_at | date: site.date_format, site.timezone }}</time>
      {% endif %}
      {% for term in post.terms %}<a class="term" title="{{ term.vocabulary }}" href="{{ term.url | url }}">{{ term.name }}</a>{% endfor %}
    </p>

    {% if post.excerpt %}<p class="excerpt">{{ post.excerpt }}</p>{% endif %}
  </div>
</article>
