#!/usr/bin/env bash
# Commit message validation. Rules and examples: CONTRIBUTING.md section 5.
# In an emergency you may use `git commit --no-verify`, but never push
# non-conforming commits to a remote.
set -uo pipefail

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

subject="$(head -n1 "$msg_file")"

# Allow generated commits through untouched
case "$subject" in
  Revert\ *|Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

types='feat|fix|refactor|perf|test|docs|chore|build|ci|revert'
scopes='site|admin|core|db|platform|theme-kit|themes|api|editor|scripts|repo'

errors=()

if ! printf '%s' "$subject" | grep -Eq "^(${types})(\((${scopes})\))?!?: "; then
  errors+=("wrong format: expected <type>(<scope>): <subject>")
else
  body="${subject#*: }"
  printf '%s' "$body" | grep -Eq '^[a-z]' || errors+=("subject must start lowercase: '$body'")
  case "$body" in *.) errors+=("subject must not end with a period") ;; esac
  if printf '%s' "$body" | LC_ALL=C grep -q '[^ -~]'; then
    errors+=("subject must be plain English (ASCII): '$body'")
  fi
  [ "${#subject}" -le 72 ] || errors+=("subject is ${#subject} chars, limit is 72")
fi

if [ ${#errors[@]} -gt 0 ]; then
  printf '\n  x invalid commit message:\n' >&2
  for e in "${errors[@]}"; do printf '      - %s\n' "$e" >&2; done
  cat >&2 <<'USAGE'

  format: <type>(<scope>): <subject>
    type      feat | fix | refactor | perf | test | docs | chore | build | ci | revert
    scope     site | admin | core | db | platform | theme-kit | themes | api | editor | scripts | repo
    subject   English . imperative . lowercase . no trailing period . <= 72 chars

  examples:
    feat(db): add d1 schema for pages posts and products
    fix(theme-kit): stop caching parsed templates across revisions

  Rules: CONTRIBUTING.md section 5. To bypass: git commit --no-verify
USAGE
  exit 1
fi

exit 0
