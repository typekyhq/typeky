#!/usr/bin/env bash
# End-of-day push reminder. Rules: CONTRIBUTING.md section 5.1.
#
# After a commit, if we are outside working hours and something still needs to
# leave the machine, print a short reminder. Deliberately silent during the day
# and when everything is already pushed, so it stays useful instead of noise.
#
# The reminder window spans midnight, because evening sessions regularly run
# past 00:00. Quiet hours are 04:00-21:59 by default.
#   TYPEKY_REMIND_FROM=22   first hour that reminds (default 22)
#   TYPEKY_REMIND_UNTIL=4   first hour that stops reminding (default 4)
set -uo pipefail

FROM="${TYPEKY_REMIND_FROM:-22}"
UNTIL="${TYPEKY_REMIND_UNTIL:-4}"
hour=$((10#$(date +%H)))

if [ "$hour" -ge "$FROM" ] || [ "$hour" -lt "$UNTIL" ]; then
  : # inside the reminder window
else
  exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

if ! git remote | grep -q .; then
  printf '\n  Reminder: no git remote configured, so push is impossible.\n'
  printf '            Your local .git is the only copy of this work.\n'
  printf '            git remote add origin <url> && git push -u origin main\n\n'
  exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)

if [ -z "$upstream" ]; then
  printf '\n  Reminder: branch %s has no upstream yet.\n' "$branch"
  printf '            git push -u origin %s\n\n' "$branch"
  exit 0
fi

ahead=$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)
dirty=$(git status --porcelain | wc -l | tr -d ' ')

if [ "$ahead" -gt 0 ] || [ "$dirty" -gt 0 ]; then
  printf '\n  End-of-day reminder (%s)\n' "$(date +%H:%M)"
  [ "$dirty" -gt 0 ] && printf '    - %s file(s) not committed\n' "$dirty"
  [ "$ahead" -gt 0 ] && printf '    - %s commit(s) not pushed\n' "$ahead"
  printf '    Flow: pnpm check  ->  git commit  ->  git push\n\n'
fi
exit 0
