#!/usr/bin/env bash
# Gate before pushing: typecheck plus asset boundary assertions.
# The full check (including tests) is documented in CONTRIBUTING.md section 7;
# this hook deliberately runs only the fast checks so everyday pushes stay quick.
set -euo pipefail

echo "pre-push -> pnpm typecheck"
pnpm --silent typecheck
echo "pre-push -> pnpm check:boundaries"
pnpm --silent check:boundaries
echo "pre-push -> ok"
