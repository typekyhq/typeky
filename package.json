{
  "name": "typeky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.mjs",
    "dev:site": "pnpm --filter @typeky/site dev",
    "dev:admin": "pnpm --filter @typeky/admin dev",
    "types": "pnpm --filter @typeky/site types",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build && node scripts/build-site.mjs",
    "deploy:dry-run": "pnpm build && pnpm --filter @typeky/site exec wrangler deploy --dry-run",
    "deploy": "pnpm build && pnpm --filter @typeky/site exec wrangler deploy",
    "test": "vitest run --passWithNoTests",
    "db:generate": "tsx packages/db/scripts/schema.ts generate",
    "check:schema-drift": "tsx packages/db/scripts/schema.ts check",
    "db:migrate": "wrangler d1 migrations apply DB --local --config apps/site/wrangler.jsonc",
    "db:reset": "node scripts/db-reset.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config apps/site/wrangler.jsonc",
    "seed": "tsx packages/db/scripts/seed.ts",
    "admin:password": "tsx apps/site/scripts/hash-password.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:schema-drift && pnpm check:theme-drift && pnpm check:context && pnpm build && pnpm check:boundaries",
    "theme:generate": "tsx packages/themes/default/scripts/baseline.ts generate",
    "check:theme-drift": "tsx packages/themes/default/scripts/baseline.ts check",
    "test:sandbox": "vitest run packages/theme-kit/src/sandbox.test.ts",
    "check:context": "tsx scripts/check-context.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@typeky/core": "workspace:*",
    "@typeky/theme-default": "workspace:*",
    "@typeky/theme-kit": "workspace:*",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.1"
  }
}
